# ==========================================
# SchoolChakra Environment Configuration
# ==========================================

# 1. Google Sheets Webhook URL (Google Apps Script Web App Deployment)
# Recommended for frontend-only Jamstack architecture (zero server required).
# Once deployed, copy your Web App URL here:
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# 2. Cal.com Scheduling Link
# The event slug or booking page URL (e.g. your-team/demo or schoolchakra/walkthrough)
VITE_CALCOM_LINK="schoolchakra/walkthrough"

# 3. WhatsApp Direct Contact Number (with international country code, no + or spaces)
# Used for the instant WhatsApp connect CTA on the success view:
VITE_WHATSAPP_PHONE="919876543210"

# ---------------------------------------------------------------------------------
# (Optional) Direct Google Sheets API v4 (if using a Google Cloud Service Proxy instead of Apps Script)
# ---------------------------------------------------------------------------------
# VITE_GOOGLE_SHEETS_SPREADSHEET_ID="your_google_spreadsheet_id_here"
# VITE_GOOGLE_SHEETS_API_KEY="AIzaSy..."
# VITE_GOOGLE_SHEETS_ACCESS_TOKEN="ya29..."

